# Local production accounts, credentials and resource details.
# Preferred location: sibling folder ../生产物料/ (outside this repo).
# Keep the shareable inventory in docs/ under version control.
# Also ignore if someone mistakenly creates 生产物料/ inside the repo.
/生产物料/

# Local detector test photos (multi-GB originals, not product source).
/测试用/

# Generated prototype dumps, playwright traces and inline copies.
# Canonical sync helper is prototype/sync-inline.js.
/output/

# Recreated detector research clones (not production docs).
/docs/research/

# Environment values are local; sanitized examples/templates are source.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
!.env.*.sample
!.env.*.template

