# Managed by Realphotos S7 deploy. Placeholder rollback:
#   /root/蜜獾原图-v2/shared/nginx-exif-demo.placeholder.conf
# Rollback: cp placeholder -> sites-enabled, nginx -t, systemctl reload nginx
#
# 配置真源：本文件（仓库内）。部署脚本 06_nginx.sh 会用它覆盖
# /etc/nginx/sites-available/exif-demo.honeybadgersoft.com.conf。
# client_max_body_size 200m 是业务要求（多图批量上传），不要改回 25m/50m。
# __AOJ_PROXY_SHARED_SECRET__ 由部署脚本从 shared/backend.env 注入，仓库内不得存明文。

server {
  listen 80;
  listen [::]:80;
  server_name exif-demo.honeybadgersoft.com;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/letsencrypt;
    default_type "text/plain";
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name exif-demo.honeybadgersoft.com;

  ssl_certificate /etc/letsencrypt/live/exif-demo.honeybadgersoft.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/exif-demo.honeybadgersoft.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Frame-Options "SAMEORIGIN" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;

  client_max_body_size 200m;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/letsencrypt;
    default_type "text/plain";
  }

  # FastAPI: API, health, static (controlled gateway paths stay behind auth)
  location ^~ /api/v1/ {
    proxy_pass http://127.0.0.1:38000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header x-aoju-proxy-key "__AOJ_PROXY_SHARED_SECRET__";
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
  }

  location = /health {
    proxy_pass http://127.0.0.1:38000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header x-aoju-proxy-key "__AOJ_PROXY_SHARED_SECRET__";
  }

  location ^~ /static/ {
    proxy_pass http://127.0.0.1:38000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header x-aoju-proxy-key "__AOJ_PROXY_SHARED_SECRET__";
  }

  # Next.js app shell and /_next/*
  location / {
    proxy_pass http://127.0.0.1:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 300s;
  }
}
