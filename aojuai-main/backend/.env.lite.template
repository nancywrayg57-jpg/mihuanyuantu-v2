# AOJU Backend - 轻量档（SQLite 单机）配置模板
# 复制为 backend/.env 即可运行：无 PostgreSQL、无 Redis、单进程。适合试点/演示/小团队（<50 人）。
# 需要多进程、多实例、后台 worker 集群或高并发时，切换到 .env.production.template（PostgreSQL + Redis）。

APP_NAME=AOJUAI
DEBUG=false
ENV=production

# ---- 数据库：SQLite ----
DB_DRIVER=sqlite
SQLITE_PATH=./data/aoju.db
# immediate（缺省）：事务串行化，写不丢；deferred：读多写少可换更高吞吐（并发写以 database is locked 报错）
SQLITE_BEGIN_MODE=immediate

# ---- Redis：轻量档关闭（运行时缓存走进程内本地缓存）----
REDIS_ENABLED=false

# ---- 首次启动自动建表 + 灌初始数据（admin / Admin@123456，test / Test@123456，请立即改密）----
AUTO_INIT_DB=true
AUTO_SEED_DATA=true

# ---- 安全：生产必须改 ----
SECRET_KEY=change-me-to-a-long-random-string
PROVIDER_SECRET_KEY=change-me-too-and-never-rotate-casually
# 受信代理边界（Nginx 注入）；本机直连调试可留空
# TRUSTED_PROXY_KEY=

# ---- 模块安装（不列 = 不装）----
AOJ_ENABLED_MODULES=

# ---- 定时任务：单进程内跑；关闭则不启动调度器 ----
SCHEDULER_ENABLED=true
