# AOJU Backend - Production Environment Configuration Template
# Copy this file to .env and modify values

# Application
APP_NAME=AOJUAI
APP_VERSION=0.1.0
DEBUG=false
ENV=production

# API
API_V1_PREFIX=/api/v1

# Public CMS ownership: off (default), domain, or path.
# Keep PUBLIC_SITE_DOMAINS aligned with active Tenant.domain values so Next can
# decide domain-mode ownership without a database request in middleware.
PUBLIC_SITE_ROUTING_MODE=off
PUBLIC_SITE_DOMAINS=
# Development only; leave empty in production.
CMS_DEFAULT_TENANT_CODE=

# CORS
CORS_ORIGINS=["https://aoju.ai","https://www.aoju.ai"]

# Database
DB_HOST=your-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-secure-password
DB_NAME=aoju
DB_ECHO=false

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=your-redis-password

# JWT - IMPORTANT: Generate a strong secret key for production
# You can use: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-production-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ACCESS_COOKIE_NAME=aoju_access_token
AUTH_REFRESH_COOKIE_NAME=aoju_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax

# Security
PASSWORD_MIN_LENGTH=8
AOJ_PROXY_SHARED_SECRET=replace-with-a-strong-shared-proxy-secret

# SMTP (optional; leave SMTP_HOST/SMTP_FROM_EMAIL empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Development helpers (optional)
AUTO_INIT_DB=false
AUTO_SEED_DATA=false

# Scheduler (optional)
SCHEDULER_ENABLED=true
EXAMPLE_TASK_ENABLED=false
MESSAGE_GATEWAY_TASKS_ENABLED=false

# WeChat (QR Connect) - optional
# Configure redirect URI in WeChat Open Platform (must match exactly)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_REDIRECT_URI=
WECHAT_SCOPE=snsapi_login
WECHAT_STATE_TTL_SECONDS=300
