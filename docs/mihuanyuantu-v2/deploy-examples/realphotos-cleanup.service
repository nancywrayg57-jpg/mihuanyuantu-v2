# 开发机示例 · 非 S7。
[Unit]
Description=realphotos cleanup worker (AD-001)
After=network.target postgresql.service

[Service]
Type=simple
User=hbs
WorkingDirectory=/home/hbs/hbs-projects/mihuanyuantu-v2/aojuai-main/backend
EnvironmentFile=-/home/hbs/hbs-projects/mihuanyuantu-v2/aojuai-main/backend/.env
Environment=AOJ_ENABLED_MODULES=realphotos
ExecStart=/home/hbs/hbs-projects/mihuanyuantu-v2/aojuai-main/backend/.venv/bin/python -m scripts.run_realphotos_cleanup_worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
