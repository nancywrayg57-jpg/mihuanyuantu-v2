{
	email admin@huangzhisong.com
}

huangzhisong.com {
	encode gzip zstd
	request_body {
		max_size 650MB
	}

	handle /api/health {
		header Content-Type application/json
		respond `{"status":"ok","service":"huang-archive"}` 200
	}

	handle /api/* {
		reverse_proxy pocketbase:8090
	}

	handle /_/* {
		reverse_proxy pocketbase:8090
	}

	@static path *.js *.css *.svg *.png *.jpg *.webp *.ico
	handle @static {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache, no-store, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

